# Servidor (ignorado em serverless)
PORT=5000

# Credenciais do Firebase — OBRIGATÓRIO em produção
# O ficheiro .json da conta de serviço está no .gitignore e não existe no
# servidor. Colar aqui o conteúdo integral desse ficheiro (numa só linha) ou
# o mesmo em base64. Em desenvolvimento local pode ficar vazio: nesse caso o
# código usa o ficheiro *firebase-adminsdk*.json da pasta Backend.
FIREBASE_SERVICE_ACCOUNT=

# Origens autorizadas a chamar a API (separadas por vírgula). Sem esta
# variável o CORS fica aberto a todos — aceitável em dev, não em produção.
CORS_ORIGINS=https://mukanda-prepa-app.vercel.app,https://mukandaprepa.vercel.app

# Segredo do agendador que fecha sessões expiradas (/api/cron/sessoes-expiradas).
# Sem esta variável o endpoint fica acessível sem autenticação.
CRON_SECRET=troca-por-uma-string-aleatoria-longa


# Autenticação (JWT) — obrigatório
JWT_SECRET=troca-por-uma-string-aleatoria-longa

# Conta de administrador criada automaticamente no arranque (só na 1ª vez)
ADMIN_NOME=Nome do Administrador
ADMIN_EMAIL=admin@mukandaprepa.ao
ADMIN_SENHA=senha-temporaria-troca-no-1o-login

# URL da app (usado nos botões dos emails) — o domínio real em produção
APP_URL=http://localhost:5173

# Email transaccional (opcional) — sem estas variáveis, os emails ficam
# "em modo simulado": aparecem no terminal em vez de serem enviados,
# o que é suficiente para testar tudo localmente. Para envio real, uma
# conta Gmail com "palavra-passe de aplicação" funciona bem com estes
# valores (Definições da Google → Segurança → Palavras-passe de aplicações):
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=suporte@mukandaprepa.ao
EMAIL_PASS=palavra-passe-de-aplicacao
EMAIL_FROM=MUKANDA PREPA <suporte@mukandaprepa.ao>
