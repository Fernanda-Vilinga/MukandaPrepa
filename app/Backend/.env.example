# ============================================================================
# MUKANDA PREPA — variáveis de ambiente do backend
#
# Copiar para .env (que está no .gitignore) e preencher. Em produção, as mesmas
# variáveis definem-se no painel da hospedagem — no Vercel em
# Settings → Environment Variables.
#
# Gerado a partir do código a 2 de Agosto de 2026. Esta lista é a referência de
# tudo o que o servidor lê: se acrescentares uma variável nova ao código,
# acrescenta-a também aqui.
# ============================================================================


# ── OBRIGATÓRIAS ────────────────────────────────────────────────────────────

# Credenciais do Firebase (Firestore).
# O JSON INTEIRO da conta de serviço, numa só linha, ou o mesmo em base64.
# Obtém-se em: Firebase → Definições do projecto → Contas de serviço →
# Gerar nova chave privada.
#
# Atenção aos \n da private_key: ao colar numa variável de ambiente ficam
# muitas vezes escapados como texto. O código já os desescapa, mas se o SDK
# reclamar "Failed to parse private key" é quase sempre isso.
#
# Em desenvolvimento local podes em alternativa deixar esta variável vazia e
# colocar o ficheiro *firebase-adminsdk*.json na pasta Backend — está no
# .gitignore e nunca deve ir para o repositório.
FIREBASE_SERVICE_ACCOUNT=

# Segredo que assina os tokens de sessão (JWT). Qualquer texto longo e
# aleatório. Mudá-lo invalida todas as sessões abertas.
# Gerar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=


# ── ENDEREÇOS ───────────────────────────────────────────────────────────────

# Origens autorizadas a chamar a API, separadas por vírgula (sem barra final).
# Vazio = aceita qualquer origem, o que só serve para desenvolvimento local.
# Incluir o site institucional E a app.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Endereço público da app, usado nos links dos emails (recuperação de senha,
# resultados). Sem isto, os emails saem com links que não levam a lado nenhum.
APP_URL=http://localhost:5174

# Raiz pública desta API. Só é preciso definir se o servidor estiver atrás de
# algo que altere o cabeçalho Host; caso contrário é deduzida de cada pedido.
# Usada para construir os endereços das imagens.
# API_PUBLIC_URL=https://mukandaprepa-backend.vercel.app/api

# Porta do servidor em desenvolvimento local. Em serverless é ignorada.
PORT=5000


# ── EMAIL ───────────────────────────────────────────────────────────────────
#
# Sem EMAIL_HOST, EMAIL_USER e EMAIL_PASS o servidor arranca à mesma e escreve
# os emails no terminal em vez de os enviar. Útil em desenvolvimento; em
# produção significa que ninguém recebe nada.
#
# Com Gmail, EMAIL_PASS NÃO é a senha da conta: é uma "palavra-passe de
# aplicação", criada em myaccount.google.com/apppasswords (exige verificação
# em dois passos activa).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=MUKANDA PREPA <mukandaprepa@gmail.com>

# Logótipo mostrado no topo dos emails. Tem de ser um endereço público — os
# clientes de email não conseguem ler ficheiros do nosso servidor privado.
EMAIL_LOGO_URL=

# Tempo máximo de espera pelo servidor de email, em milissegundos.
# Existe porque em serverless a função é congelada assim que responde: se o
# envio ficasse a decorrer depois da resposta, nunca chegaria a acontecer.
# Todos os envios são esperados antes de responder, e este é o tecto.
EMAIL_TIMEOUT_MS=8000


# ── SESSÕES E SEGURANÇA ─────────────────────────────────────────────────────

# Durante quanto tempo (ms) o servidor guarda em memória o estado e o papel de
# um utilizador, antes de os reler da base de dados.
#
# É o compromisso entre rapidez de uma suspensão e número de leituras: os chats
# consultam o servidor de 6 em 6 segundos, e sem cache cada pedido seria uma
# leitura. Com 60 s, uma conta suspensa perde o acesso em menos de um minuto.
# Suspender pelo painel de administração tem efeito imediato de qualquer forma.
AUTH_CACHE_MS=60000

# Protege o endereço que fecha as sessões expiradas (/api/cron/sessoes-expiradas),
# chamado pelo agendador da hospedagem. Sem isto, qualquer pessoa o pode invocar.
# O agendador tem de enviar: Authorization: Bearer <este valor>
CRON_SECRET=


# ── CONTA DE ADMINISTRADOR INICIAL ──────────────────────────────────────────
#
# Criada automaticamente no primeiro pedido, se ainda não existir. Depois de a
# conta existir, estas variáveis deixam de ter efeito — mudar a senha aqui NÃO
# muda a senha da conta já criada.
ADMIN_EMAIL=
ADMIN_SENHA=
ADMIN_NOME=Administrador
