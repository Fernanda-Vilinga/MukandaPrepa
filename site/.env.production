# Configuração usada no build de produção (`vite build`) do site.
# Ver a nota em app/.env.production: as variáveis VITE_* são públicas por
# natureza e podem ser substituídas por variáveis definidas na hospedagem.

VITE_APP_URL=https://mukandaprepa-app.vercel.app

# API do backend — o site só a usa no formulário de contacto.
VITE_API_BASE=https://mukandaprepa-backend.vercel.app/api
